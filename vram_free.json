    "AMDRSServ", "AMDRSSrcExt", "cncmd", "AMDNoiseSuppression", "RadeonSoftware_service", "steamservice",
    "Battle.net", "Agent", "Blizzard Update Agent", "lghub_agent", "lghub_system_tray", "lghub", "EpicGamesLauncher", "OneDrive", "iCUE", "Corsair.Service"
  ]
