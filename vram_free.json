    { "name": "Edge",     "enabled": true, "processes": ["msedge"], "close": "window", "restart_args": "--restore-last-session" },
    { "name": "Steam",    "enabled": true, "processes": ["steam", "steamwebhelper"], "close": "command", "command_args": "-shutdown", "restart_args": "-silent" },
    { "name": "Stremio",  "enabled": true, "processes": ["stremio"], "close": "window" },
    { "name": "VLC",      "enabled": true, "processes": ["vlc"], "close": "window" },
    { "name": "RadeonSoftware (UI only)", "enabled": true, "processes": ["RadeonSoftware"], "close": "window" },
    { "name": "Teams",    "enabled": true, "processes": ["ms-teams"], "close": "window" },
